Step 4: Generate Buy/Sell Signals

Now, we define trading logic based on trend analysis.

def generate_trade_signal(df):
    """Generates trading signals based on indicators"""
    
    last_row = df.iloc[-1]  # Get last available data row

    # **Bollinger Band Analysis**
    price_above_bb_upper = last_row['close'] > last_row['BB_upper']
    price_below_bb_lower = last_row['close'] < last_row['BB_lower']

    # **Moving Average Crossover**
    bullish_ma_crossover = (last_row['MA_20'] > last_row['MA_50'] > last_row['MA_100'] > last_row['MA_200'])
    bearish_ma_crossover = (last_row['MA_20'] < last_row['MA_50'] < last_row['MA_100'] < last_row['MA_200'])

    # **Stochastic RSI Overbought/Oversold Conditions**
    stoch_rsi_overbought = last_row['stoch_rsi_k'] > 80 and last_row['stoch_rsi_d'] > 80
    stoch_rsi_oversold = last_row['stoch_rsi_k'] < 20 and last_row['stoch_rsi_d'] < 20

    # **Bullish Condition**
    if (price_below_bb_lower and stoch_rsi_oversold) or bullish_ma_crossover:
        return "BUY"

    # **Bearish Condition**
    if (price_above_bb_upper and stoch_rsi_overbought) or bearish_ma_crossover:
        return "SELL"

    return "HOLD"

# Get trade signal
trade_signal = generate_trade_signal(crypto_data)
print(f"Trade Signal: {trade_signal}")


