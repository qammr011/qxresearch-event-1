Step 2: Set Up Crypto Market Data Fetching

We'll use ccxt to fetch real-time crypto data (e.g., BTC/USDT).

import ccxt
import pandas as pd
import ta

# Initialize Binance API (No authentication needed for public data)
exchange = ccxt.binance()

def fetch_crypto_data(symbol="BTC/USDT", timeframe="1h", limit=200):
    """Fetches historical OHLCV data from Binance"""
    bars = exchange.fetch_ohlcv(symbol, timeframe, limit=limit)
    
    # Convert to DataFrame
    df = pd.DataFrame(bars, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
    
    # Convert timestamp to readable format
    df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')
    
    return df

# Fetch market data
crypto_data = fetch_crypto_data()
print(crypto_data.tail())


