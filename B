Step 5: Execute Trades

Connect to Binance API and place trades.

def execute_trade(signal, symbol="BTC/USDT", quantity=0.001):
    """Executes trade based on the signal"""

    api_key = "YOUR_BINANCE_API_KEY"
    api_secret = "YOUR_BINANCE_SECRET_KEY"
    
    binance = ccxt.binance({
        'apiKey': api_key,
        'secret': api_secret,
        'enableRateLimit': True
    })

    if signal == "BUY":
        order = binance.create_market_buy_order(symbol, quantity)
        print("Buy Order Placed:", order)

    elif signal == "SELL":
        order = binance.create_market_sell_order(symbol, quantity)
        print("Sell Order Placed:", order)

    else:
        print("No trade executed.")

# Execute trade
execute_trade(trade_signal)


