Step 3: Compute Indicators

Now, we add Bollinger Bands, Moving Averages, and Stochastic RSI.

def compute_indicators(df):
    """Calculates Bollinger Bands, Moving Averages, and Stochastic RSI"""

    # Bollinger Bands
    df['BB_upper'] = ta.volatility.bollinger_hband(df['close'], window=20, fillna=True)
    df['BB_middle'] = ta.volatility.bollinger_mavg(df['close'], window=20, fillna=True)
    df['BB_lower'] = ta.volatility.bollinger_lband(df['close'], window=20, fillna=True)

    # Moving Averages
    df['MA_20'] = ta.trend.sma_indicator(df['close'], window=20, fillna=True)
    df['MA_50'] = ta.trend.sma_indicator(df['close'], window=50, fillna=True)
    df['MA_100'] = ta.trend.sma_indicator(df['close'], window=100, fillna=True)
    df['MA_200'] = ta.trend.sma_indicator(df['close'], window=200, fillna=True)

    # Stochastic RSI
    df['stoch_rsi'] = ta.momentum.stochrsi(df['close'], window=14, fillna=True)
    df['stoch_rsi_k'] = ta.momentum.stochrsi_k(df['close'], window=14, smooth1=3, smooth2=3, fillna=True)
    df['stoch_rsi_d'] = ta.momentum.stochrsi_d(df['close'], window=14, smooth1=3, smooth2=3, fillna=True)

    return df

# Compute indicators
crypto_data = compute_indicators(crypto_data)
print(crypto_data.tail())


